/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "types": [],
    /* Le tsconfig racine fait pointer `@lets-ple/ui` vers les sources de `libs/ui`, ce que
       ng-packagr refuse pour un build de lib isolé (TS6059 : ces sources ne sont pas sous le
       `rootDir` de ce paquet). Ce build isolé consomme donc le paquet déjà compilé dans `dist/ui`
       (voir `npm run build:cryptogramme`, qui garantit que `dist/ui` est à jour avant ce build) —
       uniquement `@lets-ple/ui` : rien n'importe encore `@lets-ple/game-core` ni `@lets-ple/cryptogramme`
       lui-même, donc pas besoin du même traitement pour ces alias. */
    "paths": {
      "@lets-ple/ui": ["../../../dist/ui/types/lets-ple-ui.d.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
