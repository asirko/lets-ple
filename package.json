{
  "name": "lets-ple",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "tsx scripts/serve.ts portal",
    "ticket": "tsx scripts/ticket.ts",
    "ticket:deps": "tsx scripts/ticket.ts --detach-deps",
    "ticket:clean": "tsx scripts/ticket.ts --clean",
    "build": "ng build portal",
    "watch": "ng build --watch --configuration development",
    "test": "vitest run --config vitest.domain.config.ts",
    "test:watch": "vitest --config vitest.domain.config.ts",
    "test:ng": "ng test",
    "test:all": "npm run test && npm run test:ng",
    "validate:quotes": "tsx projects/games/cryptogramme/tools/validate-quotes.ts",
    "score:quotes": "tsx projects/games/cryptogramme/tools/score-quotes.ts",
    "extract:quotes": "tsx projects/games/cryptogramme/tools/extract-quotekg-citations.ts",
    "filter:quotes": "tsx projects/games/cryptogramme/tools/filter-quotekg-candidates.ts",
    "import:quotes": "tsx projects/games/cryptogramme/tools/import-quotekg-candidates.ts",
    "docs": "compodoc -p tsconfig.doc.json -s",
    "build:ui": "ng build ui",
    "build:cryptogramme": "npm run build:ui && ng build cryptogramme"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "@angular/service-worker": "^22.0.8",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2200.0",
    "@angular-devkit/build-angular": "^22.0.0",
    "@angular-devkit/core": "^22.0.0",
    "@angular/animations": "^22.0.0",
    "@angular/build": "^22.0.8",
    "@angular/cli": "^22.0.8",
    "@angular/compiler-cli": "^22.0.0",
    "@compodoc/compodoc": "^2.0.0",
    "@types/node": "^20.19.43",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "firebase-tools": "^15.26.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "^22.0.0",
    "playwright": "^1.62.0",
    "prettier": "^3.8.1",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.8"
  }
}
